# Local development: copy to .env (or .dev.vars) and fill in.
# Production: set each value as a Worker secret with `npx wrangler secret put NAME`.

# Signs sessions and download links. A random string of 32 or more characters (16 at least), for example from
# node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Production only. Asked once to create the first account on a public address (not on localhost), so nobody
# else can claim a new site. Any random string of 16+ characters; you can delete it once your account exists.
SETUP_TOKEN=

# Optional. Accounts kept in a secret instead of the app's database: JSON of username to password hash.
# Run `node scripts/new-logins.mjs <username>` and paste the AUTH_USERS line it prints (every $ escaped as \$).
AUTH_USERS=

# Optional. Account that owns data from before accounts existed and whose connector token is MCP_TOKEN.
# Default: the first account in AUTH_USERS (none when every account is made in the app).
PRIMARY_USER=

# Optional, production only. The site's main host name, e.g. cv.example.com. Visitors on any other address of the
# Worker move there, and links and connector addresses use it. Older addresses keep working for existing connectors.
CANONICAL_HOST=

# AI providers, all optional. Used in this order: Anthropic, OpenAI, then the free Workers AI model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# MCP connector token, at least 24 random characters. Each account gets its own connector URL from it.
MCP_TOKEN=

# Optional AI-text detector for CVs and letters (aiornot.com).
AIORNOT_API_KEY=
